    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-b2b_e_commerce_email_worker-b5f986a8-11e5-4a75-b0af-45eb7e7a8553</UserSecretsId>
